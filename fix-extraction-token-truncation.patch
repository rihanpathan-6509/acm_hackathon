From 0d764d00fb42fef8b57cc58d1aef1953664d4396 Mon Sep 17 00:00:00 2001
From: Claude <assistant@local>
Date: Sat, 15 Aug 2026 14:27:17 +0000
Subject: [PATCH] Fix extraction responses getting cut off mid-JSON on longer
 prescriptions
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

'Model did not return valid JSON' with a raw response that visibly cuts
off mid-object (e.g. '..."timing": "1 - 0 - 1",' with nothing after)
was a token-limit truncation, not a malformed-response bug — the SDK
call never set maxOutputTokens, so it ran on whatever default the
model/SDK falls back to. A prescription with several medications, each
carrying its own confidence + field_flags array per the schema, is
long enough JSON to hit that ceiling.

- config/gemini.js: explicit maxOutputTokens (8192 extraction, 2048
  chat) instead of leaving it unset.
- geminiService.js: check finishReason === 'MAX_TOKENS' right after
  the call and throw a specific, actionable error instead of letting
  it surface later as an opaque JSON parse failure.
- extractionService.js: the JSON.parse error handler was slicing only
  the first 500 chars of the raw response for its error message,
  which hides exactly the tail where a truncation cutoff is visible.
  Now shows response length + both head and tail, and includes the
  actual JSON.parse error message (position/line/column), so a
  genuine malformed-JSON bug is now distinguishable from a truncation
  at a glance instead of both looking identical.

Verified the new error message against the exact truncated shape from
the screenshot — it now reports the real parse position instead of a
blind 500-char slice.
---
 backend/config/gemini.js              |  8 ++++++++
 backend/services/extractionService.js | 12 +++++++++++-
 backend/services/geminiService.js     | 13 +++++++++++++
 3 files changed, 32 insertions(+), 1 deletion(-)

diff --git a/backend/config/gemini.js b/backend/config/gemini.js
index 6b3877e..4a55f5d 100644
--- a/backend/config/gemini.js
+++ b/backend/config/gemini.js
@@ -46,6 +46,13 @@ function getExtractionModel(modelName = EXTRACTION_MODELS[0]) {
     generationConfig: {
       temperature: 0.1, // low temp: we want faithful reads, not creative ones
       responseMimeType: "application/json",
+      // Explicit, not left to the SDK/model default. A prescription with
+      // several medications or a lab report with a full CBC+lipid panel
+      // produces a long JSON body (every field carries its own confidence
+      // + field_flags array) — an unset/low default risks the response
+      // getting cut off mid-object, which then fails JSON.parse with a
+      // confusing "not valid JSON" error that doesn't explain why.
+      maxOutputTokens: 8192,
     },
   });
 }
@@ -55,6 +62,7 @@ function getChatModel(modelName = CHAT_MODELS[0]) {
     model: modelName,
     generationConfig: {
       temperature: 0.4,
+      maxOutputTokens: 2048,
     },
   });
 }
diff --git a/backend/services/extractionService.js b/backend/services/extractionService.js
index 150805d..95a1e99 100644
--- a/backend/services/extractionService.js
+++ b/backend/services/extractionService.js
@@ -29,8 +29,18 @@ async function extractDocument(base64Image, mimeType) {
   try {
     parsed = JSON.parse(rawText);
   } catch (err) {
+    // Show the tail, not just the head — if this was a MAX_TOKENS
+    // truncation that slipped past the finishReason check in
+    // geminiService.js (e.g. an older SDK version that doesn't expose it),
+    // the cutoff is only visible at the end of the response. The previous
+    // head-only slice made every truncation and every genuine malformed-
+    // JSON bug look identical and undiagnosable.
+    const preview =
+      rawText.length <= 800
+        ? rawText
+        : `${rawText.slice(0, 400)}\n...[${rawText.length - 800} chars omitted]...\n${rawText.slice(-400)}`;
     throw new Error(
-      `Model did not return valid JSON. Raw response: ${rawText.slice(0, 500)}`
+      `Model did not return valid JSON (${err.message}). Response length: ${rawText.length} chars. Raw response:\n${preview}`
     );
   }
 
diff --git a/backend/services/geminiService.js b/backend/services/geminiService.js
index fe15875..4e32449 100644
--- a/backend/services/geminiService.js
+++ b/backend/services/geminiService.js
@@ -129,6 +129,19 @@ async function generateExtraction(prompt, inlineImage) {
     async (modelName) => {
       const model = getExtractionModel(modelName);
       const result = await model.generateContent(parts);
+
+      // Detect truncation explicitly rather than letting it surface later
+      // as an opaque "Model did not return valid JSON" — a MAX_TOKENS
+      // finish is a distinct, actionable failure (raise the limit / the
+      // document has more items than expected), not a malformed-request
+      // error, so it shouldn't be silently indistinguishable from one.
+      const finishReason = result.response.candidates?.[0]?.finishReason;
+      if (finishReason === "MAX_TOKENS") {
+        throw new Error(
+          `${modelName} hit the output token limit before finishing the JSON response — the document likely has more medications/tests than the response budget allows. Raise maxOutputTokens in config/gemini.js or simplify the document.`
+        );
+      }
+
       return result.response.text();
     },
     "generateExtraction"
-- 
2.43.0

